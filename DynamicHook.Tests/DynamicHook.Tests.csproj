<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net6.0;net8.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>DynamicHook.Tests</RootNamespace>
    <AssemblyName>DynamicHook.Tests</AssemblyName>
    <!-- Suppress net472 obsolete warnings to keep output clean -->
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicHook\DynamicHook.csproj" />
  </ItemGroup>

</Project>
