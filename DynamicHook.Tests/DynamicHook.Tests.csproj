<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net472 is Windows-only; include it only when building on Windows so
         Linux/macOS can still build/test the cross-platform TFMs. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net472;net6.0;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net6.0;net8.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>DynamicHook.Tests</RootNamespace>
    <AssemblyName>DynamicHook.Tests</AssemblyName>
    <!-- Suppress net472 obsolete warnings to keep output clean -->
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicHook\DynamicHook.csproj" />
  </ItemGroup>

</Project>
